---
interface Props {
  title: string;
}

const { title } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/notion_icon.png', Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Jordi Bru Carci',
  url: 'https://jordibru.cloud',
  jobTitle: 'Platform Engineer',
  worksFor: {
    '@type': 'Organization',
    name: 'Mango',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Barcelona',
    addressCountry: 'ES',
  },
  sameAs: ['https://github.com/JordiiBru', 'https://www.linkedin.com/in/jordi-bru-carci/'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Jordi Bru Carci, Platform Engineer at Mango in Barcelona. Kubernetes, Terraform, GitOps, and self-hosted infrastructure. Portfolio with experience, projects, and talks." />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Platform Engineer @ Mango. Infrastructure, automation, and everything in between." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="Platform Engineer @ Mango. Infrastructure, automation, and everything in between." />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="icon" type="image/png" href="/notion_icon.png" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=satoshi@300,400,500,700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=satoshi@300,400,500,700&display=swap" /></noscript>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Satoshi', sans-serif;
    font-weight: 400;
    background: #fff;
    color: #111;
    -webkit-font-smoothing: antialiased;
  }

  *::selection {
    background: #fde68a !important;
    color: #111 !important;
  }

  *::-moz-selection {
    background: #fde68a !important;
    color: #111 !important;
  }

  a {
    color: inherit;
    text-decoration: none;
  }
</style>
