---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={`Jordi Bru Carci — ${title}. Platform Engineer @ Mango.`} />
    <link rel="icon" type="image/png" href="/faro.png" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=satoshi@300,400,500,700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=clash-display@400,500,600,700&f[]=satoshi@300,400,500,700&display=swap" /></noscript>
    <title>{title} | Jordi Bru Carci</title>
  </head>
  <body>
    <div class="page">
      <header class="header">
        <a href="/" class="back">&larr; Index</a>
        <span class="label">{title}</span>
      </header>
      <article class="content">
        <h1 class="page-title">{title}</h1>
        <div class="body">
          <slot />
        </div>
      </article>
      <footer class="footer">
        <a href="/">Jordi Bru Carci</a>
        <span>&copy; 2026</span>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: 'Satoshi', sans-serif;
    font-weight: 400;
    background: #fff;
    color: #111;
    -webkit-font-smoothing: antialiased;
  }

  *::selection {
    background: #fde68a !important;
    color: #111 !important;
  }

  *::-moz-selection {
    background: #fde68a !important;
    color: #111 !important;
  }

  a {
    color: inherit;
  }

  .page {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 2rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 1rem;
    border-bottom: 2px solid #7c3aed;
    margin-bottom: 3rem;
  }

  .back {
    font-size: 0.875rem;
    text-decoration: none;
    font-weight: 400;
    letter-spacing: 0.05em;
  }

  .back:hover {
    color: #7c3aed;
  }

  .label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #767676;
    font-weight: 700;
  }

  .content {
    flex: 1;
  }

  .page-title {
    font-family: 'ClashDisplay-Variable', 'Clash Display', sans-serif;
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 2.5rem;
  }

  .body {
    font-size: 1rem;
    line-height: 1.75;
    color: #333;
  }

  .body h2 {
    font-family: 'ClashDisplay-Variable', 'Clash Display', sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    color: #111;
    margin-top: 2.5rem;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .body h2:first-child {
    margin-top: 0;
  }

  .body h3 {
    font-family: 'ClashDisplay-Variable', 'Clash Display', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: #111;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .body .date {
    display: block;
    font-size: 0.8rem;
    font-weight: 400;
    color: #767676;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .body p {
    margin-bottom: 1rem;
  }

  .body ul {
    margin-bottom: 1rem;
    padding-left: 1.25rem;
    list-style-type: '- ';
  }

  .body li {
    margin-bottom: 0.3rem;
    padding-left: 0.25rem;
  }

  .body a {
    color: #111;
    text-decoration: underline;
    text-decoration-color: #ccc;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: text-decoration-color 0.2s ease;
  }

  .body a:hover {
    text-decoration-color: #7c3aed;
    text-decoration-thickness: 2px;
  }

  .body strong {
    font-weight: 700;
    color: #111;
  }

  .body hr {
    border: none;
    border-top: 1px solid #ddd;
    margin: 2rem 0;
  }

  .footer {
    display: flex;
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 2px solid #7c3aed;
    font-size: 0.75rem;
    color: #767676;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .footer a {
    color: #767676;
    text-decoration: none;
  }

  .footer a:hover {
    color: #7c3aed;
  }

  @media (max-width: 600px) {
    .page {
      padding: 2rem 1.25rem;
    }

    .header {
      margin-bottom: 2rem;
    }
  }
</style>
