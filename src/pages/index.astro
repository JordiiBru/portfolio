---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import notionIcon from '../assets/profile_pics/notion_icon.png';
import linkedinIcon from '../assets/profile_pics/linkedin_icon.png';

const sections = [
  { name: 'About', href: '/about/', number: '01' },
  { name: 'Experience', href: '/experience/', number: '02' },
  { name: 'Projects', href: '/projects/', number: '03' },
  { name: 'Talks', href: '/talks/', number: '04' },
  { name: 'Hobbies', href: '/hobbies/', number: '05' },
];

// r=46 in viewBox 100x100 → circumference ≈ 289
const R = 46;
const CIRC = +(2 * Math.PI * R).toFixed(2);
---

<Layout title="Jordi Bru Carci">
  <div class="page">
    <header class="header">
      <div class="header-top">
        <span class="name">Jordi Bru Carci</span>
        <nav class="header-links">
          <a href="https://github.com/JordiiBru" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="https://www.linkedin.com/in/jordi-bru-carci/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </nav>
      </div>
      <div class="hero">
        <div class="hero-text">
          <h1 class="title">Platform Engineer</h1>
          <p class="role">@ Mango</p>
          <p class="subtitle">Infrastructure, automation, and everything in between.</p>
        </div>
        <button class="avatar" id="avatar" aria-label="Flip profile image" tabindex="0">
          <!--
            SVG rotated -90deg so the arc starts from 12 o'clock.
            Two circles at the same radius:
              ring-track  — static gray full circle (always visible)
              ring-progress — lila arc that fills over 3s (the countdown)
          -->
          <svg class="avatar-ring" viewBox="0 0 100 100" overflow="visible" aria-hidden="true">
            <circle
              class="ring-track"
              cx="50" cy="50" r={R}
              fill="none" stroke="#e0e0e0" stroke-width="0.7"
            />
            <circle
              class="ring-progress"
              id="ring-progress"
              cx="50" cy="50" r={R}
              fill="none" stroke="#7c3aed" stroke-width="0.9"
              stroke-linecap="round"
              stroke-dasharray={CIRC}
              stroke-dashoffset={CIRC}
            />
            <!-- Ripple circle: expands + fades when countdown completes -->
            <circle
              class="ring-ripple"
              id="ring-ripple"
              cx="50" cy="50" r={R}
              fill="none" stroke="#7c3aed" stroke-width="0.9"
            />
          </svg>
          <div class="avatar-inner" id="avatar-inner">
            <Image src={notionIcon} alt="Jordi Bru Carci" class="avatar-face avatar-front" loading="eager" fetchpriority="high" widths={[110, 160, 220]} sizes="(max-width: 600px) 110px, clamp(100px, 16vw, 220px)" />
            <Image src={linkedinIcon} alt="Jordi Bru Carci" class="avatar-face avatar-back" loading="eager" widths={[110, 160, 220]} sizes="(max-width: 600px) 110px, clamp(100px, 16vw, 220px)" />
          </div>
        </button>
      </div>
    </header>

    <nav class="sections">
      {sections.map((s) => (
        <a href={s.href} class="section-link">
          <span class="section-number">{s.number}</span>
          <span class="section-name">{s.name}</span>
          <span class="section-arrow">&rarr;</span>
        </a>
      ))}
    </nav>

    <footer class="footer">
      <span>Barcelona</span>
      <span>&copy; 2026</span>
    </footer>
  </div>
</Layout>

<script>
  const btn    = document.getElementById('avatar') as HTMLButtonElement | null;
  const inner  = document.getElementById('avatar-inner');
  const arc    = document.getElementById('ring-progress') as SVGCircleElement | null;
  const ripple = document.getElementById('ring-ripple') as SVGCircleElement | null;

  if (!btn || !inner || !arc || !ripple) throw new Error('missing avatar elements');

  let flipped = false;
  let pending = true;

  function doFlip() {
    flipped = !flipped;
    inner.style.transform = flipped ? 'rotateY(180deg)' : 'rotateY(0deg)';
    btn.classList.toggle('flipped', flipped);
  }

  function dismissArc(fast: boolean) {
    arc.style.transition = `opacity ${fast ? '0.15s' : '0.4s'} ease`;
    arc.style.opacity = '0';
  }

  // Arc fills over 3s → ripple expands+fades → flip
  arc.classList.add('counting');
  arc.addEventListener('animationend', () => {
    if (!pending) return;
    pending = false;

    ripple.classList.add('active');
    doFlip();
    dismissArc(false);
  }, { once: true });

  // Manual click: cancel everything, flip immediately
  btn.addEventListener('click', () => {
    if (pending) {
      pending = false;
      arc.classList.remove('counting');
      dismissArc(true);
    }
    doFlip();
  });

  btn.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      btn.click();
    }
  });
</script>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2.5rem 2rem;
  }

  .header {
    margin-bottom: 3rem;
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2.5rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #7c3aed;
  }

  .name {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }

  .header-links {
    display: flex;
    gap: 1.5rem;
  }

  .header-links a {
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    position: relative;
  }

  .header-links a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background: #7c3aed;
    transition: width 0.3s ease;
  }

  .header-links a:hover::after {
    width: 100%;
  }

  .hero {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .hero-text {
    flex: 1;
  }

  .title {
    font-family: 'ClashDisplay-Variable', 'Clash Display', sans-serif;
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }

  .role {
    font-size: 1.125rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 0.5rem;
    letter-spacing: 0.02em;
  }

  .subtitle {
    font-size: 1rem;
    font-weight: 400;
    color: #666;
  }

  .avatar {
    display: block;
    width: clamp(100px, 16vw, 220px);
    height: clamp(100px, 16vw, 220px);
    flex-shrink: 0;
    perspective: 600px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    outline: none;
    position: relative;
  }

  /* Gap between image and ring: inset -16px gives ~10-14px actual gap */
  .avatar-ring {
    position: absolute;
    inset: -9px;
    width: calc(100% + 18px);
    height: calc(100% + 18px);
    /* rotate so progress starts from 12 o'clock */
    transform: rotate(-90deg);
    transform-origin: center;
    pointer-events: none;
  }

  /* Transition on base element so it animates in both directions */
  .ring-track {
    transition: stroke 0.5s ease;
  }

  .avatar.flipped .ring-track {
    stroke: #7c3aed;
  }

  @media (hover: hover) {
    .avatar:hover .ring-track {
      stroke: #7c3aed;
    }
  }

  /* The countdown arc: fills from dashoffset=CIRC to 0 over 3s */
  .ring-progress.counting {
    animation: countdown 3s linear forwards;
  }

  @keyframes countdown {
    to { stroke-dashoffset: 0; }
  }

  .avatar:focus-visible .avatar-inner {
    box-shadow: 0 0 0 3px #7c3aed;
    border-radius: 50%;
  }

  .avatar-inner {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    transition: transform 400ms ease;
    border-radius: 50%;
  }

  .avatar-face {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .avatar-back {
    transform: rotateY(180deg);
  }

  /* Ripple: separate circle that expands outward and fades on completion */
  .ring-ripple {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .ring-ripple.active {
    animation: ripple-expand 0.5s ease-out forwards;
  }

  @keyframes ripple-expand {
    0%   { transform: scale(1);    opacity: 0.7; }
    100% { transform: scale(1.2);  opacity: 0;   }
  }

  @media (prefers-reduced-motion: reduce) {
    .avatar-inner { transition: none; }
    .ring-progress.counting { animation: none; }
    .ring-ripple.active { animation: none; }
  }

  .sections {
    flex: 1;
    display: flex;
    flex-direction: column;
    border-top: 1px solid #ddd;
  }

  .section-link {
    display: flex;
    align-items: center;
    padding: 1.75rem 0;
    border-bottom: 1px solid #ddd;
    transition: padding-left 0.3s ease;
    cursor: pointer;
  }

  .section-link:hover {
    padding-left: 1.5rem;
  }

  .section-link:hover .section-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .section-number {
    font-size: 0.75rem;
    font-weight: 400;
    color: #767676;
    width: 3rem;
    flex-shrink: 0;
  }

  .section-name {
    font-family: 'ClashDisplay-Variable', 'Clash Display', sans-serif;
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    flex: 1;
  }

  .section-arrow {
    font-size: 1.25rem;
    opacity: 0;
    color: #7c3aed;
    transform: translateX(-10px);
    transition: all 0.3s ease;
  }

  .footer {
    display: flex;
    justify-content: space-between;
    padding-top: 1.5rem;
    margin-top: 2rem;
    border-top: 2px solid #7c3aed;
    font-size: 0.75rem;
    color: #767676;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  @media (max-width: 600px) {
    .page { padding: 1.5rem 1.25rem; }
    .header { margin-bottom: 2rem; }
    .header-top { margin-bottom: 1.5rem; }
    .hero { align-items: flex-start; gap: 1rem; }
    .avatar { width: 110px; height: 110px; }
    .title { font-size: clamp(2rem, 10vw, 2.5rem); }
    .section-link { padding: 1rem 0; }
  }
</style>
